{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Démarrer le Backend",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "type": "shell",
      "label": "Démarrer le Frontend",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "presentation": {
        "panel": "new",
        "reveal": "always"
      }
    },
    {
      "label": "Lancer Client et Serveur",
      "dependsOn": ["Démarrer le Backend", "Démarrer le Frontend"]
    }
  ]
}
